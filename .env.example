# Copy to .env.local (or .env) and fill in from Supabase: Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chat assistant (server-only; never NEXT_PUBLIC_). Get a key at aistudio.google.com.
GEMINI_API_KEY=
# Optional, defaults to gemini-3.5-flash (falls back to gemini-3.1-flash-lite)
GEMINI_MODEL=
